{
  "buildCommand": "npx prisma generate && next build",
  "env": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "@nextflow_clerk_publishable_key",
    "CLERK_SECRET_KEY": "@nextflow_clerk_secret",
    "DATABASE_URL": "@nextflow_database_url",
    "TRIGGER_API_KEY": "@nextflow_trigger_key",
    "GOOGLE_GENERATIVE_AI_KEY": "@nextflow_gemini_key",
    "TRANSLOADIT_KEY": "@nextflow_transloadit_key",
    "TRANSLOADIT_SECRET": "@nextflow_transloadit_secret"
  }
}
